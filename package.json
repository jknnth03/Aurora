{
	"name": "aurora",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"local": "vite --mode local.dev --host",
		"dev": "vite --mode development --host",
		"prod": "vite --mode production --host",
		"build:dev": "tsc -b && vite build --mode development",
		"build:prod": "tsc -b && vite build --mode production",
		"preview:dev": "vite preview --mode development",
		"preview:prod": "vite preview --mode production",
		"lint": "eslint .",
		"generate:scss": "tsc src/utils/generateCss.ts && mv src/utils/generateCss.js src/utils/generateCss.cjs && node src/utils/generateCss.cjs"
	},
